# Server Configuration
# Set USE_HTTPS=true to serve TLS directly via uvicorn (run ./generate_certs.sh first).
# Set USE_HTTPS=false if terminating TLS with NGINX or for local HTTP development.
HOST=0.0.0.0
PORT=8001
USE_HTTPS=true

# Admin Portal PIN (optional - leave blank or unset for open access)
# ADMIN_PIN=1234
